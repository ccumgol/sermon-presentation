{
  "name": "sermon-presentation",
  "version": "0.1.0",
  "private": true,
  "description": "OBS 브라우저 소스로 성경 본문과 찬양 가사를 송출하는 로컬 애플리케이션",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run app:build && node server/index.ts",
    "start:lan": "SERMON_HOST=0.0.0.0 npm start",
    "serve": "node server/index.ts",
    "dev": "concurrently -n app,srv -c cyan,green \"vite build --watch\" \"node --watch server/index.ts\"",
    "app:build": "vite build",
    "bible:build": "node scripts/build-bible-db.ts",
    "bible:verify": "node scripts/verify-bible-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "hymns:import": "node scripts/import-hymns.ts",
    "lyrics:realign": "node scripts/realign-lyrics.ts",
    "chorus:merge": "node scripts/merge-chorus.ts",
    "measure:meter": "node scripts/measure-meter-ranking.ts",
    "lyrics:lang": "node scripts/import-lyrics-lang.ts",
    "titles:borrow": "node scripts/borrow-en-titles.ts",
    "password": "node scripts/set-password.ts",
    "hymn:bilingual": "node scripts/import-hymn-bilingual.ts",
    "report:missing-en": "node scripts/report-missing-english.ts",
    "restore:lyrics": "node scripts/restore-song-lyrics.ts",
    "praise:check": "node scripts/check-praise-folder.ts",
    "report:bilingual": "node scripts/report-bilingual-hymns.ts",
    "report:hyphen": "node scripts/report-hyphen-linebreaks.ts",
    "hymn:realign": "node scripts/realign-hymn-english.ts",
    "misc:import": "node scripts/import-misc-lyrics.ts",
    "song:retitle": "node scripts/retitle-with-alt.ts",
    "sheets:convert": "node scripts/convert-sheets.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.3",
    "pino-pretty": "^13.1.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
