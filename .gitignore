node_modules/
dist/
build/
out/

# 생성물 및 사용자 데이터 — 원본 DB에서 다시 빌드할 수 있으므로 커밋하지 않음
# 빌드/검증 리포트는 data/reports/ 에 생성된다
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

.DS_Store
*.log
.env
.env.local

# Vite 빌드 산출물 (컨트롤 패널)
public/app/

# 테스트 커버리지 리포트 (vitest --coverage 생성물)
coverage/

# 테스트용 임시 데이터
.test-data/

# Claude Code 개인 설정 (launch.json 은 프로젝트 공용이라 커밋한다)
.claude/settings.local.json

# Obsidian 편집기 설정 — 이 PC 의 창 배치·테마다.
# 다른 PC 에서 받으면 그쪽 배치를 덮어써 오히려 방해가 된다.
.obsidian/

# 포장 산출물 (Phase 6)
#
# `release/` 에는 설치 파일(_core · _full)과 자료 꾸러미가 들어간다.
# **_full 설치 파일에는 성경·가사·악보가 통째로 들어 있다** — 올리면 그것이 곧
# 저작권 문제다. 이 두 줄이 그것을 막는 마지막 방어선이니 지우지 말 것.
dist-server/
release/

# 설치 파일을 만들 때 자료 꾸러미가 담기는 자리 (build-data/README.txt 참고).
# 안내문만 저장소에 두고 자료는 올리지 않는다.
build-data/*
!build-data/README.txt
